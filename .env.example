# DigiSafe configuration
# ---------------------------------------------------------------------------
# COPY THIS FILE TO ".env" (same folder as main.py) AND FILL IN YOUR VALUES.
#
#     Windows :  copy .env.example .env
#     macOS   :  cp .env.example .env
#
# .env is listed in .gitignore, so it is never committed and your password
# never leaves your machine. This file (.env.example) holds no real values and
# IS committed, so anyone cloning the project knows what to fill in.
#
# The server reads .env automatically on startup - no need to type `set` or
# `export` in a terminal every time.
# ---------------------------------------------------------------------------


# === EMAIL: makes verification codes arrive in real inboxes =================
#
# Leave these blank and DigiSafe still runs, but codes are printed in the
# server console instead of being emailed. Fill them in and every person who
# signs up - on Gmail, Yahoo, Outlook, or a university address - receives their
# own code in their own inbox, which is the point.
#
# Full walkthrough, including how to get a Gmail App Password: EMAIL_SETUP.md

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true

# The mailbox DigiSafe sends FROM.
SMTP_USER=your.address@gmail.com

# NOT your normal Google password - Gmail rejects that from an application.
# Generate a 16-character App Password at
# https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be switched on first).
# Quotes let you paste it with or without the spaces Google shows it in.
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# What recipients see in the From line.
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME=DigiSafe


# === PUBLIC ADDRESS ========================================================
#
# Used to build the "Verify my account" link inside the email.
#
# LEAVE THIS BLANK for local use and for Cloudflare tunnels. Blank means the
# link is built from whatever address the browser actually used, so it works on
# localhost, on your phone over Wi-Fi, and through a tunnel whose hostname
# changes on every restart - with no edits.
#
# Set it only on a permanent deployment, e.g.
#   APP_BASE_URL=https://digisafe-knust.onrender.com
# Doing so also pins it, so a forged Host header cannot put another domain into
# a verification link.
APP_BASE_URL=


# === VERIFICATION BEHAVIOUR ================================================

# How long a 6-digit code stays valid.
VERIFICATION_TTL_MINUTES=30

# Seconds a person must wait between "resend code" requests.
VERIFICATION_RESEND_COOLDOWN=60

# Wrong guesses allowed before the code is cancelled and must be resent.
VERIFICATION_MAX_ATTEMPTS=8

# Set to false ONLY for an offline walkthrough with no internet at all.
# Accounts then become usable the moment they are created, which is not how the
# system is meant to run.
DIGISAFE_REQUIRE_VERIFICATION=true


# === SECURITY KEYS =========================================================

# Signs the login tokens. Any long random string. Change it for a real
# deployment; if it changes, everyone simply has to sign in again.
SECRET_KEY=change-me-to-a-long-random-string

# AES-256 key for encrypting evidence at rest. EXACTLY 32 characters.
#
# This one must stay CONSTANT once evidence exists. Changing it makes every
# record already in the database undecryptable - for this system that means
# permanently destroying a victim's evidence.
DIGISAFE_AES_KEY=DigiSafeSecretEncryptionKey2026!


# === DEMONSTRATION DATA ====================================================

# true brings back the sample cases and the one-click role logins.
# Keep it false on anything reachable from the internet: those buttons would
# hand any visitor an administrator session.
DIGISAFE_SEED_DEMO=false
